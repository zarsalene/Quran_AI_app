ٌ","p":"حَققُ"},{"t":"مَّعْلُومٌ","p":"ممممَعلُۥۥۥۥم","v":["ممممَعلُۥۥمُل"]}]},{"a":25,"w":[{"t":"لِّلسَّآئِلِ","p":"لِسسَااااءِلِ"},{"t":"وَٱلْمَحْرُومِ","p":"وَلمَحرُۥۥۥۥم","v":["وَلمَحرُۥۥمِ"]}]},{"a":26,"w":[{"t":"وَٱلَّذِينَ","p":"وَللَذِۦۦنَ"},{"t":"يُصَدِّقُونَ","p":"يُصَددِقُۥۥنَ"},{"t":"بِيَوْمِ","p":"بِيَومِ"},{"t":"ٱلدِّينِ","p":"ددِۦۦۦۦن","v":["ددِۦۦنِ"]}]},{"a":27,"w":[{"t":"وَٱلَّذِينَ","p":"وَللَذِۦۦنَ"},{"t":"هُم","p":"هُم"},{"t":"مِّنْ","p":"مممِن"},{"t":"عَذَابِ","p":"عَذَاابِ"},{"t":"رَبِّهِم","p":"رَببِهِم"},{"t":"مُّشْفِقُونَ","p":"مممُشفِقُۥۥۥۥن","v":["مممُشفِقُۥۥنَ"]}]},{"a":28,"w":[{"t":"إِنَّ","p":"ءِننننَ"},{"t":"عَذَابَ","p":"عَذَاابَ"},{"t":"رَبِّهِمْ","p":"رَببِهِم"},{"t":"غَيْرُ","p":"غَيرُ"},{"t":"مَأْمُونٍ","p":"مَءمُۥۥۥۥن","v":["مَءمُۥۥنِوو"]}]},{"a":29,"w":[{"t":"وَٱلَّذِينَ","p":"وَللَذِۦۦنَ"},{"t":"هُمْ","p":"هُم"},{"t":"لِفُرُوجِهِمْ","p":"لِفُرُۥۥجِهِم"},{"t":"حَـٰفِظُونَ","p":"حَاافِظُۥۥۥۥن","v":["حَاافِظُۥۥنَ"]}]},{"a":30,"w":[{"t":"إِلَّا","p":"ءِللَاا"},{"t":"عَلَىٰٓ","p":"عَلَاااا"},{"t":"أَزْوَٰجِهِمْ","p":"ءَزوَااجِهِم"},{"t":"أَوْ","p":"ءَو"},{"t":"مَا","p":"مَاا"},{"t":"مَلَكَتْ","p":"مَلَكَت"},{"t":"أَيْمَـٰنُهُمْ","p":"ءَيمَاانُهُم"},{"t":"فَإِنَّهُمْ","p":"فَءِننننَهُم"},{"t":"غَيْرُ","p":"غَيرُ"},{"t":"مَلُومِينَ","p":"مَلُۥۥمِۦۦۦۦن","v":["مَلُۥۥمِۦۦنَ"]}]},{"a":31,"w":[{"t":"فَمَنِ","p":"فَمَنِ"},{"t":"ٱبْتَغَىٰ","p":"بڇتَغَاا"},{"t":"وَرَآءَ","p":"وَرَااااءَ"},{"t":"ذَٰلِكَ","p":"ذَاالِكَ"},{"t":"فَأُو۟لَـٰٓئِكَ","p":"فَءُلَااااءِكَ"},{"t":"هُمُ","p":"هُمُ"},{"t":"ٱلْعَادُونَ","p":"لعَاادُۥۥۥۥن","v":["لعَاادُۥۥنَ"]}]},{"a":32,"w":[{"t":"وَٱلَّذِينَ","p":"وَللَذِۦۦنَ"},{"t":"هُمْ","p":"هُم"},{"t":"لِأَمَـٰنَـٰتِهِمْ","p":"لِءَمَاانَااتِهِم"},{"t":"وَعَهْدِهِمْ","p":"وَعَهدِهِم"},{"t":"رَٰعُونَ","p":"رَااعُۥۥۥۥن","v":["رَااعُۥۥنَ"]}]},{"a":33,"w":[{"t":"وَٱلَّذِينَ","p":"وَللَذِۦۦنَ"},{"t":"هُم","p":"هُ۾۾۾"},{"t":"بِشَهَـٰدَٰتِهِمْ","p":"بِشَهَاادَااتِهِم"},{"t":"قَآئِمُونَ","p":"قَااااءِمُۥۥۥۥن","v":["قَااااءِمُ